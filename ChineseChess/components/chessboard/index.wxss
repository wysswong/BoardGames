.board-scaler {
  position: relative;
  flex-shrink: 0;
}

.board {
  position: relative;
  transform-origin: 0 0;
  background: #e9c78f;
  background-image:
    radial-gradient(ellipse at 25% 20%, rgba(255, 244, 214, 0.55) 0%, transparent 60%),
    radial-gradient(ellipse at 75% 80%, rgba(176, 122, 56, 0.28) 0%, transparent 55%),
    repeating-linear-gradient(0deg, rgba(160, 110, 50, 0.035) 0px, rgba(160, 110, 50, 0.035) 1px, transparent 1px, transparent 8px);
  border: 5px solid #b98c52;
  border-radius: 4px;
  box-shadow: inset 0 0 0 2px #96703e, 0 6px 18px rgba(40, 26, 12, 0.45);
  box-sizing: border-box;
}

.h-line {
  position: absolute;
  height: 1px;
  background: #967446;
}

.v-line {
  position: absolute;
  width: 1px;
  background: #967446;
}

.palace-line {
  position: absolute;
  height: 1px;
  background: #967446;
  transform-origin: center center;
}

.river {
  position: absolute;
  left: 48px;
  top: 184px;
  width: 264px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 26px;
  font-weight: 500;
  color: #7a5a34;
  letter-spacing: 4px;
}

.river-word {
  display: inline-block;
}

.point {
  position: absolute;
  width: 40px;
  height: 40px;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(29, 158, 117, 0.55);
}

/* 炮位与兵卒位的传统角标：棋盘固有标记，置于交点之上、棋子之下，不拦截点击 */
.pos-mark {
  position: absolute;
  width: 0;
  height: 0;
  pointer-events: none;
}

.pos-mark .corner {
  position: absolute;
  width: 6px;
  height: 6px;
  box-sizing: border-box;
}

.pos-mark .corner.tl {
  left: -11px;
  top: -11px;
  border-left: 1px solid #967446;
  border-top: 1px solid #967446;
}

.pos-mark .corner.tr {
  left: 5px;
  top: -11px;
  border-right: 1px solid #967446;
  border-top: 1px solid #967446;
}

.pos-mark .corner.bl {
  left: -11px;
  top: 5px;
  border-left: 1px solid #967446;
  border-bottom: 1px solid #967446;
}

.pos-mark .corner.br {
  left: 5px;
  top: 5px;
  border-right: 1px solid #967446;
  border-bottom: 1px solid #967446;
}

/* 可吃的对方棋子：落点绿点会被棋子盖住，改为棋子自身加醒目绿色描边环 */
.piece.capturable {
  border-color: #1d9e75;
  box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.85), 0 0 12px 2px rgba(29, 158, 117, 0.55), 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  animation: capturable-breathe 1.2s ease-in-out infinite;
}

@keyframes capturable-breathe {
  0%, 100% {
    box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.85), 0 0 12px 2px rgba(29, 158, 117, 0.55), 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  }
  50% {
    box-shadow: 0 0 0 4px rgba(29, 158, 117, 1), 0 0 18px 5px rgba(29, 158, 117, 0.75), 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  }
}

/* 走子高亮独立层：置于棋子之上，且不拦截点击 */
.move-mark-layer {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 10;
  pointer-events: none;
}

.move-from-mark {
  position: absolute;
  left: -17px;
  top: -17px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 2px dashed #a8730c;
  background: rgba(230, 180, 40, 0.35);
  box-shadow: 0 0 8px rgba(230, 180, 40, 0.8);
  box-sizing: border-box;
}

.move-to-ring {
  position: absolute;
  left: -21px;
  top: -21px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid #a8730c;
  box-shadow: 0 0 8px 2px rgba(230, 180, 40, 0.85);
  box-sizing: border-box;
}

.piece {
  position: absolute;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 21px;
  font-weight: bold;
  background: radial-gradient(circle at 38% 30%, #fff0c8 0%, #edc98a 52%, #c99a58 100%);
  border: 1px solid #8f6538;
  box-shadow: 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  box-sizing: border-box;
}

.piece.red {
  color: #a8231e;
}

.piece.black {
  color: #1f3a5f;
}

.piece.selected {
  border-color: #1d9e75;
  background: radial-gradient(circle at 38% 30%, #fffbe8 0%, #f7e6b5 55%, #e0c685 100%);
  box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.6), 0 3px 5px rgba(50, 32, 14, 0.5);
}

.piece.last-move {
  border-color: #a8730c;
  background: radial-gradient(circle at 38% 30%, #fff6d8 0%, #f3d28a 52%, #d99a58 100%);
  box-shadow: 0 0 0 3px rgba(230, 180, 40, 0.9), 0 0 10px 2px rgba(230, 180, 40, 0.5), 0 3px 5px rgba(50, 32, 14, 0.5);
}

/* 被将军的将/帅：红色脉冲警示，优先级高于金色走子高亮 */
.piece.checked {
  border-color: #e74c3c;
  background: radial-gradient(circle at 38% 30%, #fff0d0 0%, #f5c98a 52%, #d99a58 100%);
  box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.95), 0 0 12px 3px rgba(231, 76, 60, 0.65), 0 3px 5px rgba(50, 32, 14, 0.5);
  animation: check-pulse 1.1s ease-in-out infinite;
}

@keyframes check-pulse {
  0%, 100% {
    box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.95), 0 0 12px 3px rgba(231, 76, 60, 0.65), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
  50% {
    box-shadow: 0 0 0 4px rgba(231, 76, 60, 1), 0 0 18px 6px rgba(231, 76, 60, 0.85), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
}

/* 吃子特效：落子缓缓落下 + 被吃棋子缓慢消失 + 金色扩散光圈，最上层且不拦截点击 */
.capture-fx {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 20;
  pointer-events: none;
}

.capture-ring {
  position: absolute;
  left: -17px;
  top: -17px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid #ffe6a8;
  box-sizing: border-box;
  animation: capture-burst 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

.capture-flash {
  position: absolute;
  left: -17px;
  top: -17px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 245, 205, 0.95) 0%, rgba(255, 190, 80, 0.6) 45%, transparent 72%);
  animation: capture-flash 0.85s ease-out forwards;
}

/* 被吃的棋子：原地缓慢下沉、缩小、淡出，表现被压住后消失 */
.captured-ghost {
  position: absolute;
  left: 0;
  top: 0;
  width: 34px;
  height: 34px;
  margin-left: -17px;
  margin-top: -17px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 21px;
  font-weight: bold;
  background: radial-gradient(circle at 38% 30%, #fff0c8 0%, #edc98a 52%, #c99a58 100%);
  border: 1px solid #8f6538;
  box-shadow: 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  box-sizing: border-box;
  animation: captured-sink 1.2s cubic-bezier(0.4, 0, 0.6, 1) forwards;
}

.captured-ghost.red {
  color: #a8231e;
}

.captured-ghost.black {
  color: #1f3a5f;
}

/* 落子方棋子：从上方缓缓落下，轻微触底回弹后淡出 */
.drop-ghost {
  position: absolute;
  left: 0;
  top: 0;
  width: 34px;
  height: 34px;
  margin-left: -17px;
  margin-top: -17px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 21px;
  font-weight: bold;
  background: radial-gradient(circle at 38% 30%, #fff6d8 0%, #f3d28a 52%, #d99a58 100%);
  border: 1px solid #a8730c;
  box-shadow: 0 6px 10px rgba(50, 32, 14, 0.55), 0 0 10px rgba(230, 180, 40, 0.6), inset 0 0 0 2px rgba(255, 248, 222, 0.75), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  box-sizing: border-box;
  animation: piece-drop 0.95s cubic-bezier(0.34, 1.15, 0.64, 1) forwards;
}

.drop-ghost.red {
  color: #a8231e;
}

.drop-ghost.black {
  color: #1f3a5f;
}

@keyframes capture-burst {
  0% {
    transform: scale(0.5);
    opacity: 1;
    border-color: #fff2c8;
  }
  70% {
    opacity: 0.5;
  }
  100% {
    transform: scale(2.4);
    opacity: 0;
    border-color: #d98a20;
  }
}

@keyframes capture-flash {
  0% {
    transform: scale(0.6);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

@keyframes captured-sink {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  45% {
    transform: translateY(6px) scale(0.92);
    opacity: 0.85;
  }
  100% {
    transform: translateY(14px) scale(0.4);
    opacity: 0;
  }
}

@keyframes piece-drop {
  0% {
    transform: translateY(-22px) scale(1.12);
    opacity: 0;
  }
  18% {
    opacity: 1;
  }
  62% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 0;
  }
}

/* 将帅照面警示：橙红脉冲环 + 棋子描边，与将军(红)/吃子(金)区分 */
.piece.facing {
  border-color: #ff7a1a;
  box-shadow: 0 0 0 3px rgba(255, 122, 26, 0.95), 0 0 12px 3px rgba(255, 122, 26, 0.7), 0 3px 5px rgba(50, 32, 14, 0.5);
  animation: facing-pulse 0.9s ease-in-out infinite;
}

.facing-fx {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 18;
  pointer-events: none;
}

.facing-ring {
  position: absolute;
  left: -17px;
  top: -17px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 2px solid #ff9a3c;
  box-sizing: border-box;
  animation: facing-burst 0.7s ease-out forwards;
}

@keyframes facing-pulse {
  0%, 100% {
    box-shadow: 0 0 0 3px rgba(255, 122, 26, 0.95), 0 0 12px 3px rgba(255, 122, 26, 0.7), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
  50% {
    box-shadow: 0 0 0 4px rgba(255, 122, 26, 1), 0 0 20px 7px rgba(255, 122, 26, 0.9), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
}

@keyframes facing-burst {
  0% {
    transform: scale(0.6);
    opacity: 1;
    border-color: #ffd9a8;
  }
  100% {
    transform: scale(2.4);
    opacity: 0;
    border-color: #e2620a;
  }
}

/* 送将警示：己方将帅红色脉冲（复用将军语义）+ 一次性红色扩散环 */
.piece.self-check {
  border-color: #e74c3c;
  background: radial-gradient(circle at 38% 30%, #fff0d0 0%, #f5c98a 52%, #d99a58 100%);
  box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.95), 0 0 12px 3px rgba(231, 76, 60, 0.65), 0 3px 5px rgba(50, 32, 14, 0.5);
  animation: self-check-pulse 0.9s ease-in-out infinite;
}

.self-check-fx {
  position: absolute;
  width: 0;
  height: 0;
  z-index: 19;
  pointer-events: none;
}

.self-check-ring {
  position: absolute;
  left: -17px;
  top: -17px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid #ff6b5b;
  box-shadow: 0 0 12px 3px rgba(231, 76, 60, 0.85);
  box-sizing: border-box;
  animation: self-check-burst 1s ease-out forwards;
}

@keyframes self-check-pulse {
  0%, 100% {
    box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.95), 0 0 12px 3px rgba(231, 76, 60, 0.65), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
  50% {
    box-shadow: 0 0 0 5px rgba(231, 76, 60, 1), 0 0 20px 7px rgba(231, 76, 60, 0.9), 0 3px 5px rgba(50, 32, 14, 0.5);
  }
}

@keyframes self-check-burst {
  0% {
    transform: scale(0.7);
    opacity: 1;
    border-color: #ffd0c8;
  }
  100% {
    transform: scale(2.6);
    opacity: 0;
    border-color: #c0392b;
  }
}

/* 胜负结算：胜方棋子金色光晕 + 轻微跳动 */
.piece.victory {
  border-color: #ffcf5c;
  background: radial-gradient(circle at 38% 28%, #fffbe0 0%, #ffe9a0 50%, #e8b44e 100%);
  box-shadow: 0 0 0 3px rgba(255, 207, 92, 0.95), 0 0 16px 5px rgba(255, 190, 60, 0.75), 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 250, 225, 0.85), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  animation: victory-glow 1.6s ease-in-out infinite;
}

@keyframes victory-glow {
  0%, 100% {
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 3px rgba(255, 207, 92, 0.95), 0 0 16px 5px rgba(255, 190, 60, 0.75), 0 3px 5px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 250, 225, 0.85), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  }
  50% {
    transform: translate(-50%, calc(-50% - 3px));
    box-shadow: 0 0 0 4px rgba(255, 220, 110, 1), 0 0 22px 8px rgba(255, 200, 70, 0.9), 0 5px 7px rgba(50, 32, 14, 0.5), inset 0 0 0 2px rgba(255, 250, 225, 0.85), inset 0 0 0 3px rgba(143, 101, 56, 0.5);
  }
}

/* 败方将帅：灰化 + 下沉，示意落败 */
.piece.defeat {
  border-color: #8a7d6c;
  background: radial-gradient(circle at 38% 30%, #d8d0c4 0%, #b8ad9c 52%, #8d8072 100%);
  color: #5a5147 !important;
  box-shadow: 0 0 0 2px rgba(120, 110, 96, 0.7), 0 2px 3px rgba(40, 30, 18, 0.5), inset 0 0 0 2px rgba(235, 228, 215, 0.5);
  transform: translate(-50%, calc(-50% + 4px));
  opacity: 0.9;
}

/* 胜负横幅：覆盖棋盘中央，不拦截点击 */
.result-layer {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 30;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 半透明结算横幅：降低背景与阴影不透明度，缩小占位，方便复盘被遮挡的棋子 */
.result-banner {
  position: relative;
  min-width: 132px;
  padding: 9px 20px 12px;
  text-align: center;
  background: linear-gradient(160deg, rgba(48, 30, 14, 0.3) 0%, rgba(30, 18, 8, 0.32) 100%);
  border: 2px solid rgba(230, 183, 86, 0.85);
  border-radius: 10px;
  box-shadow: 0 0 0 3px rgba(230, 183, 86, 0.18), 0 6px 16px rgba(20, 12, 6, 0.28), inset 0 0 14px rgba(255, 200, 90, 0.1);
  animation: banner-in 0.6s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}

.result-banner.black {
  border-color: rgba(159, 180, 204, 0.85);
  box-shadow: 0 0 0 3px rgba(159, 180, 204, 0.18), 0 6px 16px rgba(20, 12, 6, 0.28), inset 0 0 14px rgba(180, 205, 235, 0.1);
}

/* 和棋：中性冷色横幅，与胜负庆祝明确区分 */
.result-banner.draw {
  border-color: rgba(198, 212, 222, 0.85);
  box-shadow: 0 0 0 3px rgba(198, 212, 222, 0.18), 0 6px 16px rgba(20, 12, 6, 0.28), inset 0 0 14px rgba(210, 225, 235, 0.1);
}

.result-banner.draw .result-crown {
  color: #d8e4ec;
}

.result-banner.draw .result-title {
  color: #e2ebf2;
  font-size: 22px;
}

.result-draw-sub {
  margin-top: 3px;
  font-size: 12px;
  color: #c6d3de;
  letter-spacing: 2px;
  text-shadow: 0 1px 3px rgba(20, 12, 6, 0.9);
}

.result-crown {
  font-size: 19px;
  color: #ffd76a;
  line-height: 1;
  margin-bottom: 3px;
  text-shadow: 0 1px 3px rgba(20, 12, 6, 0.9);
  animation: crown-shine 1.4s ease-in-out infinite;
}

.result-banner.black .result-crown {
  color: #bcd2ea;
}

.result-title {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 24px;
  font-weight: bold;
  color: #ffd76a;
  letter-spacing: 3px;
  line-height: 1.2;
  text-shadow: 0 1px 4px rgba(20, 12, 6, 0.95), 0 0 2px rgba(20, 12, 6, 0.8);
}

.result-banner.black .result-title {
  color: #cfe0f2;
}

.result-ribbon {
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 7px;
  height: 1px;
  background: linear-gradient(90deg, transparent, #e6b756, transparent);
}

.result-banner.black .result-ribbon {
  background: linear-gradient(90deg, transparent, #9fb4cc, transparent);
}

@keyframes banner-in {
  0% {
    transform: scale(0.5);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes crown-shine {
  0%, 100% {
    opacity: 0.7;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}
