<view class="online-page">
  <view class="title">好友在线对战</view>
  <view class="subtitle">创建房间邀请好友，或输入房间号加入</view>

  <view wx:if="{{cloudError}}" class="error">{{cloudError}}</view>

  <button class="primary" loading="{{creating}}" bindtap="onCreate">创建房间</button>

  <view class="divider">或</view>

  <view class="join-box">
    <input class="code-input" type="number" maxlength="6" placeholder="输入 6 位房间号"
      value="{{codeInput}}" bindinput="onCodeInput" />
    <button class="join-btn" size="mini" loading="{{joining}}" bindtap="onJoin">加入</button>
  </view>
  <button class="watch-btn" size="mini" bindtap="onWatch">观战（只读）</button>

  <view class="note">创建者执红先行 · 房间号发给好友即可对弈</view>
  <button class="back-btn" size="mini" bindtap="onBack">返回</button>
</view>
