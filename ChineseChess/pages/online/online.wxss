.online-page {
  min-height: 100vh;
  padding: 60px 24px 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background: linear-gradient(160deg, #3a2718 0%, #24170d 100%);
}

.title {
  font-size: 26px;
  font-weight: bold;
  color: #f5e0b5;
}

.subtitle {
  margin-top: 10px;
  font-size: 13px;
  color: rgba(245, 224, 181, 0.7);
  text-align: center;
}

.error {
  margin-top: 20px;
  padding: 10px 14px;
  font-size: 12px;
  color: #ffb9a8;
  background: rgba(180, 60, 40, 0.18);
  border: 1px solid rgba(255, 150, 120, 0.4);
  border-radius: 6px;
  text-align: center;
  line-height: 1.5;
}

.primary {
  margin-top: 40px;
  width: 220px;
  background: #7a5230;
  color: #fff;
}

.divider {
  margin: 22px 0 16px;
  font-size: 12px;
  color: rgba(245, 224, 181, 0.5);
}

.join-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.code-input {
  width: 180px;
  height: 40px;
  padding: 0 12px;
  background: rgba(255, 245, 220, 0.1);
  border: 1px solid rgba(245, 224, 181, 0.5);
  border-radius: 6px;
  color: #f5e0b5;
  font-size: 16px;
  letter-spacing: 4px;
  text-align: center;
}

.join-btn {
  background: #7a5230;
  color: #fff;
}

.watch-btn {
  margin-top: 14px;
  background: transparent;
  color: rgba(245, 224, 181, 0.85);
  border: 1px solid rgba(245, 224, 181, 0.5);
}

.note {
  margin-top: 32px;
  font-size: 12px;
  color: rgba(245, 224, 181, 0.6);
  text-align: center;
  line-height: 1.6;
}

.back-btn {
  margin-top: 24px;
  background: transparent;
  color: rgba(245, 224, 181, 0.7);
  border: 1px solid rgba(245, 224, 181, 0.35);
}
