.game-page {
  min-height: 100vh;
  padding: 16px 16px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.online-bar {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  margin-bottom: 8px;
  background: rgba(122, 82, 48, 0.55);
  border: 1px solid rgba(245, 224, 181, 0.4);
  border-radius: 6px;
  box-sizing: border-box;
}

.online-status {
  font-size: 12px;
  color: #f5e0b5;
}

.room-code {
  font-size: 12px;
  color: #ffd76a;
  text-decoration: underline;
}

.status-bar {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.status-text {
  font-size: 14px;
  color: #f5e0b5;
}

.status-text.check {
  color: #ff9a6b;
  font-weight: bold;
}

.status-text.facing {
  color: #ffb45c;
  font-weight: bold;
}

.status-text.self-check {
  color: #ff7a6b;
  font-weight: bold;
}

.status-text.notice {
  color: #ffc85c;
  font-weight: bold;
}

.status-text.win {
  color: #ffd76a;
  font-weight: bold;
  font-size: 15px;
}

.status-text.draw {
  color: #d8e4ec;
  font-weight: bold;
  font-size: 15px;
}

.move-count {
  font-size: 12px;
  color: rgba(245, 224, 181, 0.75);
}

.board-wrap {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.actions {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-top: 20px;
}

/* 自绘胶囊按钮，替代微信 mini 按钮默认样式；文字不换行，窄屏自动折行 */
.btn {
  flex: 0 0 auto;
  margin: 0;
  padding: 7px 16px;
  min-height: 0;
  line-height: 1.2;
  font-size: 13px;
  white-space: nowrap;
  color: #f5e0b5;
  background: rgba(122, 82, 48, 0.35);
  border: 1px solid rgba(245, 224, 181, 0.55);
  border-radius: 18px;
  box-shadow: 0 2px 5px rgba(30, 18, 8, 0.3);
}

.btn::after {
  border: none;
}

.btn.primary {
  color: #fff6df;
  background: linear-gradient(160deg, #a06a38 0%, #7a5230 100%);
  border: 1px solid rgba(255, 224, 160, 0.75);
  box-shadow: 0 3px 8px rgba(30, 18, 8, 0.4), inset 0 1px 0 rgba(255, 240, 200, 0.25);
}

.btn:active {
  opacity: 0.82;
}

.tip {
  flex-shrink: 0;
  margin-top: 14px;
  font-size: 12px;
  color: rgba(245, 224, 181, 0.75);
}
