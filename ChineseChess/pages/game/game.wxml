<view class="game-page">
  <view class="status-bar">
    <text class="status-text {{isCheck && !over ? 'check' : ''}} {{isFacing ? 'facing' : ''}} {{isSelfCheck ? 'self-check' : ''}} {{notice ? 'notice' : ''}} {{over && winner ? 'win' : ''}} {{over && !winner ? 'draw' : ''}}">{{over ? (winner ? '✦ ' : '✧ ') : (isCheck || isFacing || isSelfCheck || notice ? '⚠ ' : '')}}{{statusText}}</text>
    <text class="move-count">第 {{moveCount}} 手</text>
  </view>
  <view class="board-wrap">
    <chessboard id="chessboard" board="{{board}}" selected="{{selected}}" hints="{{hints}}" last-move="{{lastMove}}" bind:pointtap="onBoardTap" />
  </view>
  <view class="actions">
    <button class="btn" size="mini" bindtap="onRestart">重新开始</button>
    <button class="btn ghost" size="mini" bindtap="onToggleBgm">{{bgmOn ? '关音乐' : '开音乐'}}</button>
    <button class="btn ghost" size="mini" bindtap="onBack">返回</button>
  </view>
  <view class="tip">红方先行 · 本地双人对战</view>
</view>
