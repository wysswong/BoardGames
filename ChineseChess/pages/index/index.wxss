.home {
  padding: 60px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  font-size: 28px;
  font-weight: 500;
  color: #7a5230;
}

.tagline {
  margin-top: 6px;
  font-size: 14px;
  color: #888780;
}

.primary {
  margin-top: 48px;
  width: 220px;
  background: #7a5230;
  color: #fff;
}

.secondary {
  margin-top: 16px;
  width: 220px;
  background: #f5efe3;
  color: #7a5230;
  border: 1px solid #7a5230;
}

.note {
  margin-top: 32px;
  font-size: 12px;
  color: #888780;
  text-align: center;
  line-height: 1.6;
}
